@model LeTienDat_241230697.Models.Sach
<div class="section-head">
	<h3>Le Tien Dat - Them Sach moi</h3>
</div>
<div class="form-book">
	<form asp-controller="LeTienDat" asp-action="ThemSach" method="post">
		@Html.AntiForgeryToken()
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="form-group">
		<label asp-for="MaTl">MaTL</label>
		<select asp-for="MaTl" asp-items="ViewBag.DanhSachTheLoai">
			<option value="">--Chon the loai---</option>
		</select>
		<span asp-validation-for="MaTl" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="TenSach">TenSach</label>
	    <input asp-for="TenSach" />
		<span asp-validation-for="TenSach" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Gia">Gia</label>
		<input asp-for="Gia" />
		<span asp-validation-for="Gia" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Anh">Anh</label>
		<input asp-for="Anh" />
		<span asp-validation-for="Anh" class="text-danger"></span>
	</div>
	<button type="submit" class="btn-buy">Create</button>
</form>
</div>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
